APP_NAME=Clutch.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clutch
DB_USERNAME=clutch
DB_PASSWORD=clutch

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

QUOTA_DAILY_IMPORTS=5
QUOTA_STORED_ANALYSES=30

DEMO_UPLOAD_DISK=s3
DEMO_UPLOAD_MAX_SIZE_BYTES=524288000
DEMO_UPLOAD_URL_TTL_MINUTES=10
DEMO_UPLOAD_RATE_LIMIT_PER_MINUTE=10

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=clutch
AWS_SECRET_ACCESS_KEY=clutch-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clutch
AWS_ENDPOINT=http://127.0.0.1:9002
AWS_URL=http://127.0.0.1:9002/clutch
AWS_USE_PATH_STYLE_ENDPOINT=true
FILESYSTEM_THROW=true

VITE_APP_NAME="${APP_NAME}"
